function markGoal(){$$('.gc').forEach(c=>c.classList.toggle('on',c.dataset.g===S.goal))}
/* workout */
function renderEx(){$$('.exs').forEach(w=>w.innerHTML=EX.map((e,i)=>`<div class="ex ${done.has(i)?'ok':''}" onclick="tick(${i})"><span class="num">${done.has(i)?'✓':'0'+(i+1)}</span><div><b>${e[0]}</b><small>${e[1]}</small></div></div>`).join(''));renderLog();wbtn()}
function tick(i){done.has(i)?done.delete(i):done.add(i);renderEx();if(done.size===EX.length)toast('All exercises done. Finish your workout!')}
const fmt=s=>String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
function wbtn(){$$('[data-wb]').forEach(b=>{b.classList.toggle('live',work.on);b.innerHTML=work.on?'Finish workout ✓':'Start workout <span class="ar">→</span>'});const t=$('#tt');if(t)t.textContent=work.on?'Finish':'Start';$('#tv').textContent=fmt(work.t)}
function toggleWorkout(){if(!work.on){work.on=true;work.id=setInterval(()=>{work.t++;$('#tv').textContent=fmt(work.t)},1000);toast('Workout started. You’ve got this!')}else{clearInterval(work.id);work.on=false;S.log.unshift({n:'Upper body',d:fmt(work.t),w:new Date().toLocaleDateString()});S.log=S.log.slice(0,8);save();work.t=0;done.clear();toast('Workout complete, great work!');renderEx()}wbtn()}
function resetTimer(){clearInterval(work.id);work={on:false,t:0,id:null};done.clear();renderEx();toast('Timer reset')}
function renderLog(){$('#logList').innerHTML=S.log.length?S.log.map(l=>`<li><span>${l.n} · ${l.w}</span><b>${l.d}</b></li>`).join(''):'<li>No sessions yet. Your first one will appear here.</li>'}
/* micro-interactions */
document.addEventListener('pointerdown',e=>{const b=e.target.closest('.btn,.add,.act');if(!b)return;const r=b.getBoundingClientRect(),d=Math.max(r.width,r.height)*2,s=document.createElement('span');s.className='rip';s.style.cssText=`width:${d}px;height:${d}px;left:${e.clientX-r.left-d/2}px;top:${e.clientY-r.top-d/2}px`;if(getComputedStyle(b).position==='static')b.style.position='relative';b.style.overflow='hidden';b.appendChild(s);setTimeout(()=>s.remove(),700)});
document.addEventListener('pointermove',e=>{const c=e.target.closest('.card.hv');if(c){const r=c.getBoundingClientRect();c.style.setProperty('--mx',e.clientX-r.left+'px');c.style.setProperty('--my',e.clientY-r.top+'px')}
$$('.btn.p').forEach(b=>{if(e.pointerType!=='mouse')return;const r=b.getBoundingClientRect(),x=e.clientX-(r.left+r.width/2),y=e.clientY-(r.top+r.height/2);b.style.transform=Math.hypot(x,y)<90?`translate(${x*.18}px,${y*.25}px)`:''})});
/* intro */
function boot(){$('#marq').innerHTML=[...CAT,...CAT].map(x=>`<span>${x.i} ${x.n}</span>`).join('');
$('#greeting')&&0;greet();$('#today').textContent=new Date().toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long'});
$('#word').innerHTML='NAIJAFIT'.split('').map((c,i)=>`<span class="${i>4?'l':''}" style="animation-delay:${.3+i*.07}s">${c}</span>`).join('');
renderEx();renderWater();pill();markGoal();
const quick=matchMedia('(prefers-reduced-motion:reduce)').matches,dur=quick?200:2600,t0=performance.now();
(function f(n){const p=Math.min(1,(n-t0)/dur),v=Math.round(ease(p)*100);$('#bar').style.width=v+'%';$('#pct').textContent=v+'%';if(p<1)return requestAnimationFrame(f);
setTimeout(()=>{$('#intro').classList.add('done');document.body.classList.add('go');document.body.classList.remove('lock');heroAnim();watchReveal();setTimeout(()=>$('#intro').remove(),1300)},300)})(t0)}
document.fonts&&document.fonts.ready?document.fonts.ready.then(boot):boot();
</script>
</body>
</html>
