<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b0f0d">
<title>NaijaFit — Eat well. Train strong.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
<style>
@property --p{syntax:'<number>';inherits:true;initial-value:0}
:root{color-scheme:dark;--bg:#0b0f0d;--card:#131a16;--card2:#19221d;--line:#25302a;--txt:#eef3ec;--mut:#92a097;--lime:#c7ff59;--ease:cubic-bezier(.2,.75,.25,1);--head:'Sora','Inter',system-ui,sans-serif;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px)}
*,*:before,*:after{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;background:var(--bg);color:var(--txt);font:15px/1.55 'Inter',system-ui,-apple-system,sans-serif;overflow-x:hidden;-webkit-tap-highlight-color:transparent}
body.lock{overflow:hidden}
body:before{content:"";position:fixed;inset:0;z-index:-1;background:radial-gradient(ellipse 70% 50% at 50% -10%,#2a3d2d,transparent 70%),radial-gradient(ellipse 40% 30% at 100% 90%,#1b2a1f,transparent)}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
h1,h2,h3{font-family:var(--head);margin:0;letter-spacing:-.03em}
.mut{color:var(--mut)}.eyebrow{color:var(--lime);font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
/* intro */
#intro{position:fixed;inset:0;z-index:100;display:grid;place-items:center}
.cur{position:absolute;left:0;right:0;height:50.5%;background:#080b09;transition:transform 1.1s cubic-bezier(.76,0,.24,1)}
.cur.t{top:0}.cur.b{bottom:0}
#intro.done .t{transform:translateY(-101%)}#intro.done .b{transform:translateY(101%)}
.ic{position:relative;text-align:center;transition:opacity .45s,transform .6s var(--ease)}
#intro.done .ic{opacity:0;transform:scale(1.08)}
.glow{position:absolute;left:50%;top:40%;width:420px;height:420px;margin:-210px;background:radial-gradient(circle,#c7ff5922,transparent 65%);animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{50%{transform:scale(1.25);opacity:.6}}
.ring-draw{width:96px;height:96px;display:block;margin:0 auto 22px;position:relative}
.ring-draw circle{fill:none;stroke:var(--lime);stroke-width:2.5;stroke-linecap:round;stroke-dasharray:289;stroke-dashoffset:289;transform-origin:center;transform:rotate(-90deg);animation:draw 1.6s .2s var(--ease) forwards}
.ring-draw text{fill:var(--lime);font-size:30px;opacity:0;animation:fadeIn .6s 1s forwards}
@keyframes draw{to{stroke-dashoffset:0}}@keyframes fadeIn{to{opacity:1}}
.word{font:800 clamp(34px,8vw,64px)/1 var(--head);letter-spacing:-.04em;display:flex;justify-content:center;overflow:hidden;padding-bottom:6px}
.word span{display:inline-block;transform:translateY(110%);animation:rise .8s var(--ease) forwards}
.word span.l{color:var(--lime)}
@keyframes rise{to{transform:none}}
.tag-i{margin-top:10px;color:var(--mut);font-size:12px;letter-spacing:.3em;text-transform:uppercase;opacity:0;animation:fadeIn .8s 1.1s forwards}
.load{width:200px;height:2px;background:#25302a;margin:30px auto 10px;border-radius:2px;overflow:hidden}.load i{display:block;height:100%;width:0;background:var(--lime);box-shadow:0 0 12px var(--lime)}
.pct{font:600 11px var(--head);color:var(--mut);font-variant-numeric:tabular-nums}
/* nav */
.nav{position:sticky;top:0;z-index:50;height:68px;padding:0 max(24px,calc((100% - 1120px)/2));display:flex;align-items:center;justify-content:space-between;gap:12px;background:#0b0f0dcc;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid #ffffff0d;transform:translateY(-100%)}
body.go .nav{transform:none;transition:transform .9s .2s var(--ease)}
.logo{font:800 20px var(--head);letter-spacing:-.04em;display:flex;align-items:center;gap:9px}.logo b{color:var(--lime)}
.mark{width:30px;height:30px;border-radius:9px;background:var(--lime);color:#0b0f0d;display:grid;place-items:center;font-size:16px;transition:transform .5s var(--ease)}.logo:hover .mark{transform:rotate(90deg) scale(1.1)}
.links{position:relative;display:flex;gap:2px;padding:4px;border-radius:12px;background:#ffffff08;border:1px solid #ffffff0d}
.links button{position:relative;z-index:1;padding:8px 14px;border-radius:9px;font-size:13px;font-weight:600;color:var(--mut);transition:color .3s}
.links button:hover,.links button.sel{color:var(--txt)}.links button.sel{color:#0b0f0d}
.pill{position:absolute;top:4px;bottom:4px;left:0;border-radius:9px;background:var(--lime);transition:transform .5s var(--ease),width .5s var(--ease);box-shadow:0 4px 18px #c7ff5940}
.avatar{width:38px;height:38px;border-radius:50%;background:var(--card2);border:1px solid var(--line);color:var(--lime);font-weight:700;display:none;place-items:center}
body[data-v]:not([data-v=home]) .avatar{display:grid}body[data-v]:not([data-v=home]) .nav .btn{display:none}
/* buttons */
.btn{position:relative;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 22px;border-radius:12px;font-weight:700;font-size:14px;transition:transform .35s var(--ease),box-shadow .35s,background .3s,border-color .3s;will-change:transform}
.btn:active{transform:scale(.95)!important}
.btn.p{background:var(--lime);color:#0b0f0d;box-shadow:0 8px 30px #c7ff5930}.btn.p:hover{box-shadow:0 12px 40px #c7ff5960}
.btn.g{border:1px solid #ffffff22;background:#ffffff08}.btn.g:hover{background:#ffffff14;border-color:#ffffff40}
.btn .ar{transition:transform .35s var(--ease)}.btn:hover .ar{transform:translateX(5px)}
.rip{position:absolute;border-radius:50%;background:#ffffff55;transform:scale(0);animation:rip .7s ease-out forwards;pointer-events:none}.g .rip{background:#c7ff5933}
@keyframes rip{to{transform:scale(1);opacity:0}}
/* layout */
.wrap{max-width:1120px;margin:auto;padding:0 22px}
.view[hidden]{display:none}.view:not([hidden]){animation:vin .6s var(--ease) both}
@keyframes vin{from{opacity:0;transform:translateY(16px)}}
[data-r]{opacity:0;transform:translateY(26px);transition:opacity .8s var(--ease),transform .8s var(--ease);transition-delay:var(--d,0s)}[data-r].in{opacity:1;transform:none}
/* hero */
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;min-height:calc(100vh - 68px);padding:40px 0}
.hero h1{font-size:clamp(42px,7vw,84px);line-height:.98;margin:16px 0 20px}
.hero h1 .w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.08em}.hero h1 .w i{display:inline-block;font-style:normal;transform:translateY(105%);transition:transform 1s var(--ease);transition-delay:calc(var(--i)*.09s + .5s)}
body.go .hero h1 .w i{transform:none}.hero h1 em{font-style:normal;color:var(--lime)}
.hero .fade{opacity:0;transform:translateY(20px);transition:all .9s var(--ease);transition-delay:calc(var(--i)*.12s + .9s)}body.go .hero .fade{opacity:1;transform:none}
.hero p.lead{font-size:18px;color:var(--mut);max-width:480px;margin:0 0 28px}
.cta{display:flex;gap:12px;flex-wrap:wrap}
.stats{display:flex;gap:34px;margin-top:44px}.stats b{display:block;font:700 28px var(--head);letter-spacing:-.03em}.stats span{font-size:12px;color:var(--mut)}
.phone{position:relative;animation:float 6s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-14px)}}
.phone .card{padding:26px;box-shadow:0 40px 80px #0008,0 0 0 1px #c7ff5914}
.chip{position:absolute;padding:10px 14px;border-radius:14px;background:#19221dee;border:1px solid var(--line);font-size:12px;font-weight:600;backdrop-filter:blur(10px);box-shadow:0 14px 34px #0006;animation:float 5s ease-in-out infinite}
.chip.a{top:-18px;right:-8px;animation-delay:-1s}.chip.b{bottom:30px;left:-26px;animation-delay:-3s}
.marq{overflow:hidden;border-block:1px solid var(--line);padding:18px 0;mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
.marq div{display:flex;gap:44px;width:max-content;animation:mq 34s linear infinite;font:700 20px var(--head);color:#ffffff55;white-space:nowrap}.marq:hover div{animation-play-state:paused}.marq span:hover{color:var(--lime)}
@keyframes mq{to{transform:translateX(-50%)}}
section.blk{padding:96px 0 0}.blk h2{font-size:clamp(30px,4.6vw,48px);margin:10px 0 14px;max-width:620px}.blk>.wrap>p{color:var(--mut);max-width:520px;margin:0 0 40px}
.feat{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.card{position:relative;background:var(--card);border:1px solid var(--line);border-radius:20px;padding:24px;overflow:hidden;transition:transform .5s var(--ease),border-color .4s}
.card.hv:hover{transform:translateY(-6px);border-color:#c7ff5944}
.card.hv:before{content:"";position:absolute;inset:0;background:radial-gradient(260px circle at var(--mx,50%) var(--my,0),#c7ff5914,transparent 70%);opacity:0;transition:opacity .4s;pointer-events:none}.card.hv:hover:before{opacity:1}
.feat .ico{width:46px;height:46px;border-radius:13px;background:#c7ff591a;display:grid;place-items:center;font-size:22px;margin-bottom:18px}
.feat h3{font-size:18px;margin-bottom:8px}.feat p{margin:0;color:var(--mut);font-size:14px}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;counter-reset:s}.steps .card:before{counter-increment:s;content:"0" counter(s);position:static;display:block;background:none;opacity:1;font:800 44px var(--head);color:#c7ff5933;margin-bottom:10px;inset:auto}
.steps h3{font-size:17px;margin-bottom:6px}.steps p{margin:0;color:var(--mut);font-size:14px}
.band{margin:96px 0 0;padding:64px 28px;border-radius:28px;text-align:center;background:linear-gradient(135deg,#25382a,#131a16);border:1px solid #c7ff5933}
.band h2{font-size:clamp(28px,4.4vw,44px);margin:0 auto 14px;max-width:560px}.band p{color:var(--mut);margin:0 auto 26px;max-width:440px}
footer{padding:50px 22px 40px;text-align:center;color:var(--mut);font-size:12px}
/* app */
.app{padding:34px 0 60px}
.welcome{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:22px}.welcome h1{font-size:34px;margin:6px 0 4px}.welcome p{margin:0;color:var(--mut);font-size:14px}
.date{padding:9px 14px;border:1px solid var(--line);border-radius:11px;background:var(--card);font-size:12px;font-weight:600}
.layout{display:grid;grid-template-columns:1.5fr 1fr;gap:18px}.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.head h2{font-size:17px}.small{font-size:12px;color:var(--mut);margin-top:2px}
.act{color:var(--lime);font-size:12px;font-weight:700;padding:7px 10px;border-radius:8px;transition:background .3s,transform .3s var(--ease)}.act:hover{background:#c7ff5914;transform:translateX(3px)}.act:active{transform:scale(.94)}
.nut{display:flex;align-items:center;gap:22px}
.ring{--p:0;width:122px;height:122px;flex:none;border-radius:50%;background:conic-gradient(var(--lime) calc(var(--p)*1%),#2a342f 0);display:grid;place-items:center;position:relative;transition:--p 1.4s var(--ease)}
.ring:before{content:"";position:absolute;inset:13px;background:var(--card);border-radius:50%}.ring div{position:relative;text-align:center}.ring strong{display:block;font:700 23px var(--head);font-variant-numeric:tabular-nums}.ring small{font-size:10px;color:var(--mut)}
.macros{flex:1}.macro{margin:10px 0}.ml{display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px}.ml span{color:var(--mut)}
.track{height:6px;border-radius:9px;background:#2a342f;overflow:hidden}.track i{display:block;height:100%;width:0;border-radius:9px;background:var(--lime);transition:width 1.2s var(--ease)}
.macro:nth-child(2) i{background:#ff9d51}.macro:nth-child(3) i{background:#a88aff}
.meal{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--line);animation:vin .5s var(--ease) both}.meal.out{animation:mout .35s forwards}@keyframes mout{to{opacity:0;transform:translateX(30px);height:0;padding:0}}
.icon{width:40px;height:40px;display:grid;place-items:center;background:var(--card2);border-radius:12px;font-size:19px;flex:none}
.mi{flex:1;min-width:0}.mi b{display:block;font-size:13px}.mi small{color:var(--mut);font-size:11px}.kc{font-size:12px;font-weight:700;white-space:nowrap;color:var(--lime)}
.x{width:26px;height:26px;border-radius:8px;color:var(--mut);transition:all .3s}.x:hover{background:#ff5a5a22;color:#ff8080;transform:rotate(90deg)}
.train{background:linear-gradient(145deg,#25362b,#131a16);border-color:#354639}
.ex{display:flex;align-items:center;gap:12px;margin:12px 0;padding:10px;border-radius:12px;cursor:pointer;transition:background .3s,transform .3s var(--ease)}.ex:hover{background:#ffffff0a;transform:translateX(4px)}
.num{width:30px;height:30px;background:#ffffff14;border-radius:9px;display:grid;place-items:center;color:var(--lime);font-size:12px;font-weight:700;transition:all .4s var(--ease)}
.ex b{display:block;font-size:13px;transition:opacity .3s}.ex small{color:var(--mut);font-size:11px}
.ex.ok .num{background:var(--lime);color:#0b0f0d;transform:rotate(360deg)}.ex.ok b{opacity:.5;text-decoration:line-through}
.start{width:100%;margin-top:6px}.start.live{background:#ff6b5a;color:#fff;box-shadow:0 8px 30px #ff6b5a40}
.days{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.day{border:1px solid var(--line);background:var(--card);border-radius:12px;padding:11px 4px;text-align:center;font-size:11px;font-weight:600;transition:all .4s var(--ease)}.day:hover{transform:translateY(-3px);border-color:#c7ff5955}.day small{display:block;color:var(--mut);font-size:9px;letter-spacing:.1em;margin-bottom:3px}
.day.act2{background:#c7ff5918;border-color:#c7ff5966;color:var(--lime)}.days.edit .day span{outline:1px dashed #c7ff5988;padding:1px 3px;border-radius:4px}
.water{margin-top:20px;padding-top:18px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.glasses{display:flex;gap:5px}.glasses i{width:14px;height:24px;border-radius:3px 3px 6px 6px;border:1.5px solid #4a6357;transition:all .4s var(--ease);cursor:pointer}.glasses i.f{background:#5fd0e6;border-color:#5fd0e6;transform:translateY(-2px)}
.ctl{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:700}.ctl button{width:30px;height:30px;border-radius:9px;border:1px solid var(--line);background:var(--card2);color:var(--lime);transition:all .3s var(--ease)}.ctl button:hover{border-color:var(--lime);transform:scale(1.1)}.ctl button:active{transform:scale(.88)}
.hero2{padding:30px;border-radius:20px;margin-bottom:18px;background:linear-gradient(115deg,#2a3d2e,#131a16);border:1px solid #3a4c3d}.hero2 h1{font-size:clamp(26px,4vw,36px);margin:6px 0}.hero2 p{margin:0;color:var(--mut)}
.field{display:grid;gap:6px;font-size:11px;font-weight:700;color:var(--mut);text-transform:uppercase;letter-spacing:.08em}
select{min-width:190px;padding:11px 12px;background:#0e1411;color:var(--txt);border:1px solid #34413a;border-radius:11px;font:inherit;transition:border-color .3s,box-shadow .3s}select:focus{outline:0;border-color:var(--lime);box-shadow:0 0 0 3px #c7ff5926}
.ctrls{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.mo{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:16px}.mo .opt{display:flex;gap:12px;align-items:center;padding:14px;border:1px solid var(--line);border-radius:14px;background:var(--card2);animation:vin .5s var(--ease) both;animation-delay:calc(var(--i)*.06s);transition:transform .4s var(--ease),border-color .3s}.mo .opt:hover{transform:translateY(-3px);border-color:#c7ff5955}
.add{border:1px solid #55703a;background:#263522;color:var(--lime);border-radius:9px;padding:7px 11px;font-size:11px;font-weight:700;transition:all .3s var(--ease)}.add:hover{background:var(--lime);color:#0b0f0d}.add:active{transform:scale(.9)}
.gg{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.gc h3{font-size:16px;margin:6px 0}.gc p{color:var(--mut);font-size:13px;margin:0 0 16px}.gc.on{border-color:var(--lime);box-shadow:0 0 0 1px var(--lime),0 16px 40px #c7ff5914}
.timer{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:18px;border-radius:14px;background:var(--card2);border:1px solid var(--line);margin:14px 0}.tv{font:700 36px var(--head);font-variant-numeric:tabular-nums;color:var(--lime)}.tb{display:flex;gap:8px}.tb .btn{padding:9px 16px}
#logList{list-style:none;margin:8px 0 14px;padding:0;font-size:13px}#logList li{padding:9px 0;border-top:1px solid var(--line);animation:vin .5s both;display:flex;justify-content:space-between;color:var(--mut)}
.toast{position:fixed;bottom:calc(86px + env(safe-area-inset-bottom,0px));left:50%;transform:translate(-50%,20px) scale(.95);opacity:0;background:var(--lime);color:#0b0f0d;font-weight:700;border-radius:12px;padding:11px 18px;font-size:13px;transition:all .45s var(--ease);pointer-events:none;z-index:60;box-shadow:0 14px 40px #0008;max-width:90vw}.toast.show{opacity:1;transform:translate(-50%,0) scale(1)}
@media(min-width:701px){.toast{bottom:28px}}
@media(max-width:860px){.hero{grid-template-columns:1fr;min-height:0;padding-top:30px}.phone{max-width:420px;margin:20px auto 0}.feat,.steps,.gg{grid-template-columns:1fr}.layout{grid-template-columns:1fr}}
@media(max-width:700px){.nav{padding:0 16px}.nav .btn{padding:9px 14px}
.links{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));z-index:70;justify-content:space-between;background:#131a16ee;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-radius:16px;padding:5px;box-shadow:0 14px 40px #000a}.links button{flex:1;padding:10px 4px;font-size:12px}.pill{top:5px;bottom:5px}
.wrap{padding:0 16px}body{padding-bottom:90px}.mo{grid-template-columns:1fr}.days{grid-template-columns:repeat(4,1fr)}.welcome h1{font-size:27px}.chip.b{left:-6px}.stats{gap:22px}.nut{flex-direction:column;align-items:flex-start}.macros{width:100%}.band{padding:48px 20px}}
.modal{position:fixed;inset:0;z-index:90;display:grid;place-items:center;padding:16px}.modal[hidden]{display:none}
.mb{position:absolute;inset:0;background:#050806cc;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);animation:fadeIn .4s both;opacity:0}
.mc{position:relative;width:100%;max-width:420px;background:var(--card);border:1px solid #c7ff5933;border-radius:24px;padding:30px;box-shadow:0 40px 100px #000a;animation:pop .55s var(--ease) both}
@keyframes pop{from{opacity:0;transform:translateY(24px) scale(.96)}}
.mc h2{font-size:26px;margin:8px 0 4px}.mx{position:absolute;top:16px;right:16px}
.tabs{position:relative;display:grid;grid-template-columns:1fr 1fr;margin:18px 0;padding:4px;border-radius:12px;background:#ffffff08;border:1px solid #ffffff0d}.tabs button{position:relative;z-index:1;padding:9px;font-weight:700;font-size:13px;color:var(--mut);transition:color .3s}.tabs button.sel{color:#0b0f0d}.tabs i{position:absolute;top:4px;bottom:4px;left:4px;width:calc(50% - 4px);border-radius:9px;background:var(--lime);transition:transform .45s var(--ease)}.tabs.in i{transform:translateX(100%)}
.fl{display:grid;gap:6px;margin-bottom:14px;font-size:11px;font-weight:700;color:var(--mut);text-transform:uppercase;letter-spacing:.08em}.fl[hidden]{display:none}.fl:not([hidden]){animation:vin .45s var(--ease) both}
.fl input{padding:13px 14px;background:#0e1411;color:var(--txt);border:1px solid #34413a;border-radius:12px;font:inherit;font-size:15px;text-transform:none;letter-spacing:0;font-weight:400;transition:border-color .3s,box-shadow .3s}.fl input:focus{outline:0;border-color:var(--lime);box-shadow:0 0 0 3px #c7ff5926}
.err{min-height:20px;color:#ff8f8f;font-size:12px;margin-bottom:8px}
.um{position:fixed;top:76px;right:max(20px,calc((100% - 1120px)/2));z-index:80;min-width:220px;padding:16px;border-radius:16px;background:var(--card);border:1px solid var(--line);box-shadow:0 20px 50px #000a;animation:pop .4s var(--ease) both}.um[hidden]{display:none}.um b{display:block;font:700 15px var(--head)}.um .small{margin:2px 0 12px;word-break:break-all}
.avatar{cursor:pointer;transition:transform .3s var(--ease),border-color .3s}.avatar:hover{transform:scale(1.08);border-color:var(--lime)}
body:not(.authed) .avatar{display:none!important}body.authed .avatar{display:grid!important}body.authed .nav .btn.si{display:none}.nav .btn.si{padding:10px 18px}
@media(max-width:700px){.nav .btn.si{display:none}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01s!important;animation-delay:0s!important;transition-duration:.01s!important;transition-delay:0s!important}}
</style>
